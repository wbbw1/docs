            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Audience"
                }
              }
            }
          }
        },
        "summary": "Get an audience",
        "security": [{"BearerAuth": []}]
      },
      "put": {
        "description": "Creates or updates audience.",
