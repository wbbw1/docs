  "paths": {
    "/send": {
      "post": {
        "description": "Use the send API to send a message to one or more recipients.",
        "operationId": "send",
        "tags": [""],
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendMessageResponse"
                }
              }
            }
          }
        },
        "summary": "Send a message",
        "security": [{"BearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
